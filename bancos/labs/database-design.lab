=== banco vendas
CREATE TABLE TipoDeProduto (
  idTipo INTEGER PRIMARY KEY,
  descTipo TEXT NOT NULL UNIQUE
);
CREATE TABLE Produto (
  idProd INTEGER PRIMARY KEY,
  nomeProd TEXT NOT NULL,
  precoProd REAL NOT NULL CHECK (precoProd >= 0),
  estoque INTEGER NOT NULL DEFAULT 0,
  idTipo INTEGER NOT NULL REFERENCES TipoDeProduto(idTipo)
);
CREATE TABLE Cliente (
  idCliente INTEGER PRIMARY KEY,
  nome TEXT NOT NULL,
  cidade TEXT,
  email TEXT UNIQUE
);
CREATE TABLE Pedido (
  idPedido INTEGER PRIMARY KEY,
  idCliente INTEGER NOT NULL REFERENCES Cliente(idCliente),
  data TEXT NOT NULL
);
CREATE TABLE ItemPedido (
  idPedido INTEGER NOT NULL REFERENCES Pedido(idPedido) ON DELETE CASCADE,
  idProd INTEGER NOT NULL REFERENCES Produto(idProd),
  qtd INTEGER NOT NULL CHECK (qtd > 0),
  PRIMARY KEY (idPedido, idProd)
);
